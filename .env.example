# --- Browser (exposed to the client; safe to be public) ---
# Supabase project URL and anon key (Project Settings > API)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# --- Server only (Vercel functions in /api; never prefix with VITE_) ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# GitHub (read-only): personal access token used by the GitHub screen.
# Fine-grained token with read access to Metadata, Contents, Issues and Pull requests
# on the repositories you want to see (or a classic token with the "repo" scope).
GITHUB_TOKEN="github_pat_..."
